auth/service-accounts.yaml

# Environment
.env
.env.local

# Daml runtime output
contracts/log/
contracts/navigator.log

# AI tooling — local-only, never committed upstream
.claude/
AGENTS.md
CLAUDE.md
.superpowers/

# git worktrees — local isolation for subagent-driven work
.worktrees/

# Local demo harness state (scripts/demo.sh)
.demo/

# Test coverage output
coverage/

# Husky managed hooks (auto-generated)
.husky/_/

# Local hook-avoidance trash dir (see CLAUDE.md memory)
.trash/

# ESLint cache
**/.cache/eslint/

# Astro marketing site
site/dist/
site/.astro/
site/test-results/
site/playwright-report/
site/.lighthouseci/
# Playwright visual-regression baselines are darwin-local; CI does not regenerate them
site/tests/**/*-snapshots/

# agent-browser user-data dir from local smoke tests
irsforge-smoke/

# Internal planning + research docs — not for upstream.
# docs/ has its own local-only git repo at docs/.git; nested-repo
# detection means we have to ignore the whole dir, not per-path.
# Root-anchor with the leading slash so it doesn't accidentally swallow
# `docs-site/docs/` (the tracked Docusaurus content tree).
/docs/
hackcanton-hackathon.md
hackcanton-irs-deep-dive.md
spike-3x/

# Stray junk
--output
